# Base de données MongoDB (résultats, jusqu'au lot 2)
DB_URL=mongodb://user:password@localhost:27017
DB_NAME=results

# URL publique du site, utilisée au build (métadonnées, sitemap, robots)
NEXT_PUBLIC_SITE_URL=
# Optionnel : adresse de contact affichée sur le site
NEXT_PUBLIC_SUPPORT_EMAIL=

# Environnement de l'application : production ou preproduction (obligatoire en
# exécution ; le démarrage est refusé sinon)
APP_ENV=
# URL publique du site à l'exécution (https), utilisée dans les liens des e-mails
SITE_URL=

# Instance Supabase de Tenga : passerelle interne du réseau Docker, jamais
# exposée (http://tenga-sb-gw:8000 en production, http://tenga-sb-preprod-gw:8000
# en préproduction). Serveur uniquement : aucune variable NEXT_PUBLIC_SUPABASE_*.
SUPABASE_URL=
# Clé secrète (sb_secret_...), au coffre (SOP-001). Lue uniquement par
# src/lib/supabase/server.ts.
SUPABASE_SECRET_KEY=

# E-mails (API Resend), serveur uniquement
RESEND_API_KEY=
EMAIL_FROM=

# Préproduction uniquement : true capte les e-mails dans un réceptacle de test
# (lecture par GET /api/mail-sink avec l'en-tête x-mail-sink-token). Le
# démarrage est REFUSÉ si MAIL_SINK=true sans APP_ENV=preproduction.
MAIL_SINK=
# Jeton de lecture du réceptacle (32 caractères au moins), si MAIL_SINK=true
MAIL_SINK_TOKEN=

# Demandes de présentation (page /presentation). Destinataire(s) de la
# notification (adresses séparées par des virgules) ; à défaut, TENGA_ADMIN_EMAILS.
# Sans aucune des deux, la demande est enregistrée mais aucune notification ne part.
PRESENTATION_RECIPIENT=
# Sel secret (16 caractères au moins) de l'empreinte hachée de l'IP. Absent ou
# trop court : la demande est enregistrée sans empreinte (jamais d'IP brute).
PRESENTATION_IP_SALT=
